{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "hd_scraper/**"
    }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index/:path*" }
  ],
  "env": {
    "HD_RAW_DIR": "/tmp/hd_raw",
    "HD_RAW_ENABLED": "0"
  }
}
